# Local (Docker): postgresql://mpen:mpen@db:5432/mpen
# Supabase: Project Settings → Database → Connection string → URI (modo Direct, para db:init)
# Hostinger (produção): use a URI do pooler (porta 6543, Session mode), se disponível
DATABASE_URL=postgresql://mpen:mpen@db:5432/mpen
PORT=8080

# O e-mail @mpen.net.br sai pelo Microsoft 365. A caixa do Sunset fica só no site sunsetvillage.com.br.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=contato@mpen.net.br
SMTP_PASS=
SMTP_FROM=contato@mpen.net.br
